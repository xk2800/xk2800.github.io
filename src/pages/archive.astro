---
import Credit from "../components/Credit.astro";
import Layout from "../layouts/Layout.astro";
import "@/styles/global.css";
import Chip from "../components/Chip.astro";

const pageTabTitle = "Project Archive | Xavier Khew";

const archive = [
  {
    year: "2023",
    sortYear: 2023,
    project: "Hartalega NGX",
    description:
      "A digital twin of their Malaysian factory — the first immersive factory tour in the healthcare industry. Lifted client sales by 80% and click-through by 68%. Led the developers, wrote code, and managed timelines and stakeholders.",
    awards: [
      "Silver, Excellence in B2B Marketing — Marketing Excellence Awards 2024",
      "Bronze, Excellence in Interactive Marketing / AR & VR — Marketing Excellence Awards 2024",
    ],
    madeAt: "Accenture Song",
    builtWith: ["HTML", "Animate.css", "SCSS", "Bootstrap 5", "GSAP", "JavaScript", "jQuery", "Three.js", "Vite"],
  },
  {
    year: "2022",
    sortYear: 2022,
    project: "RHB Cards",
    description:
      "Revamped the debit, credit, prepaid and rewards segments: 90% more user engagement and a 55% boost in click-through. Managed client and stakeholder expectations throughout.",
    awards: ["Gold, Excellence in Relationship Marketing — Marketing Excellence Awards 2023"],
    madeAt: "Accenture Song",
    builtWith: ["HTML", "CSS", "SCSS", "Bootstrap 4", "JavaScript", "Slick"],
  },
  {
    year: "2022",
    sortYear: 2022,
    project: "TM Blog",
    description: "A corporate blog showcasing leadership articles and engaging the public.",
    awards: [],
    madeAt: "Accenture Song",
    builtWith: ["HTML", "CSS", "SCSS", "Bootstrap 4", "JavaScript", "jQuery", "Moment.js", "Slick"],
  },
  {
    year: "2022",
    sortYear: 2022,
    project: "TM Brand Centre",
    description: "A brand centre that internal teams and external vendors use as the reference for brand guidelines.",
    awards: [],
    madeAt: "Accenture Song",
    builtWith: ["HTML", "CSS", "SCSS", "Bootstrap 4", "jQuery", "Slick"],
  },
  {
    year: "2022",
    sortYear: 2022,
    project: "Unifi Business",
    description: "Revamped the business product site around clearer information architecture and engaging micro-interactions.",
    awards: [],
    madeAt: "Accenture Song",
    builtWith: ["HTML", "CSS", "Bootstrap 4", "JavaScript", "jQuery", "Slick"],
  },
  {
    year: "2021–23",
    sortYear: 2021.5,
    project: "Eucerin",
    description: "Built and sent weekly emails to loyalty programme members, and maintained the loyalty website.",
    awards: [],
    madeAt: "Accenture Song",
    builtWith: ["HTML", "CSS", "Bootstrap 3", "JavaScript"],
  },
  {
    year: "2021",
    sortYear: 2021,
    project: "Desaru Coast",
    description:
      "Revamped the site’s visuals and user flow: 83% retention, 74% more click-through and 30% more bookings.",
    awards: [],
    madeAt: "Accenture Song",
    builtWith: ["HTML", "CSS", "Bootstrap 4", "JavaScript", "Slick"],
  },
  {
    year: "2021",
    sortYear: 2021,
    project: "Eve Holdings",
    description: "Improved the UX of the existing site while keeping its micro-interactions.",
    awards: [],
    madeAt: "Accenture Song",
    builtWith: ["HTML", "CSS", "Bootstrap 4", "JavaScript", "jQuery", "GSAP", "Slick"],
  },
].sort((a, b) => b.sortYear - a.sortYear);

const cols =
  "grid-cols-[4.5rem_minmax(0,1fr)_1.5rem] md:grid-cols-[6rem_minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1.6fr)_1.5rem]";
---

<Layout title={pageTabTitle}>
  <div class='mx-auto max-w-5xl'>
    <a
      href='/'
      class='rise icon-left group inline-flex w-fit items-center gap-2 text-xs font-medium text-subTextColor no-underline hover:text-baseTextColor'
      style='--i:0' transition:animate='slide'
    >
      <span aria-hidden='true' class='transition-transform duration-150 group-hover:-translate-x-1'>←</span>
      Xavier Khew
    </a>

    <h1 style='--i:1' class='rise mt-8 text-xl font-semibold tracking-tight text-baseTextCTAColor lg:text-2xl'>Project archive</h1>
    <p style='--i:2' class='rise mt-3 max-w-xl text-sm leading-relaxed text-subTextColor'>
      Client work from my years at Accenture Song. Open a project for the outcome, awards and full stack.
    </p>

    <!-- Column labels (desktop) -->
    <div style='--i:3' class={`rise mt-12 hidden gap-6 border-b border-baseTextColor/15 pb-3 text-xs font-medium text-subTextColor md:grid ${cols}`}>
      <span>Year</span>
      <span>Project</span>
      <span>Made at</span>
      <span>Built with</span>
      <span class='sr-only'>Toggle</span>
    </div>

    <ul class='mt-8 border-t border-baseTextColor/15 md:mt-0 md:border-t-0'>
      {
        archive.map((item, i) => (
          <li class='rise border-b border-baseTextColor/10' style={`--i:${3 + Math.min(i, 6) * 0.6}`}>
            <div data-acc data-open={i === 0 ? "" : undefined}>
              <button
                type='button'
                aria-expanded={i === 0 ? "true" : "false"}
                aria-controls={`panel-${i}`}
                class={`group grid w-full cursor-pointer items-baseline gap-4 py-5 text-left transition-colors duration-150 hover:bg-baseTextColor/[0.03] active:bg-baseTextColor/[0.06] md:gap-6 ${cols}`}
              >
                <span class='text-xs tabular-nums text-subTextColor'>{item.year}</span>
                <span class='min-w-0'>
                  <span class='text-sm font-medium text-baseTextCTAColor transition-colors duration-150 group-hover:text-primaryCTAColor lg:text-base'>
                    {item.project}
                  </span>
                  {item.awards.length > 0 && (
                    <span class='ml-2 inline-flex items-center gap-1 text-[0.8rem] font-medium text-primaryCTAColor'>
                      ★ {item.awards.length === 1 ? "Award" : `${item.awards.length} awards`}
                    </span>
                  )}
                </span>
                <span class='hidden text-xs text-subTextColor md:block'>{item.madeAt}</span>
                <span class='hidden truncate text-xs text-subTextColor md:block'>{item.builtWith.join(" · ")}</span>
                <span
                  aria-hidden='true'
                  class='chevron self-center text-xs text-subTextColor transition-[transform,color] duration-200 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:translate-y-0.5 group-hover:text-baseTextColor'
                >
                  ▾
                </span>
              </button>

              <div id={`panel-${i}`} class='acc-panel' inert={i !== 0}>
                <div class='acc-inner'>
                  <div class='grid grid-cols-1 gap-6 pb-8 md:grid-cols-[6rem_minmax(0,1fr)]'>
                    <span class='hidden md:block' aria-hidden='true' />
                    <div class='min-w-0 max-w-2xl'>
                      <p class='text-sm leading-relaxed text-subTextColor'>{item.description}</p>
                      {item.awards.length > 0 && (
                        <ul class='mt-5 space-y-2'>
                          {item.awards.map((a) => (
                            <li class='flex gap-2.5 text-xs font-medium text-baseTextColor'>
                              <span class='text-primaryCTAColor' aria-hidden='true'>★</span>
                              {a}
                            </li>
                          ))}
                        </ul>
                      )}
                      <p class='mt-5 text-xs text-subTextColor md:hidden'>Made at {item.madeAt}</p>
                      <ul class='mt-4 flex flex-wrap gap-2' aria-label='Built with'>
                        {item.builtWith.map((s, n) => (
                          <li class='chip-in' style={`--i:${Math.min(n, 6)}`}><Chip>{s}</Chip></li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <footer class='mt-24 border-t border-baseTextColor/10 pt-8 text-xs text-subTextColor'>
      <div class='flex flex-wrap items-center justify-between gap-4'>
        <Credit />
        <div class='flex items-center gap-5'>
          <a class='footer-link' href='https://github.com/xk2800'>Github</a>
          <a class='footer-link' href='https://www.linkedin.com/in/xavier-khew/'>LinkedIn</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style is:global>
  [data-open] .chevron { transform: rotate(180deg); color: #9b111a; }
</style>

<script>
  // One row open at a time; re-bound on every navigation (router swaps the DOM).
  document.addEventListener("astro:page-load", () => {
    const rows = document.querySelectorAll<HTMLElement>("[data-acc]");
    const set = (row: HTMLElement, open: boolean) => {
      row.toggleAttribute("data-open", open);
      row.querySelector("button")!.setAttribute("aria-expanded", String(open));
      row.querySelector<HTMLElement>(".acc-panel")!.inert = !open;
    };
    rows.forEach((row) =>
      row.querySelector("button")!.addEventListener("click", () => {
        const open = !row.hasAttribute("data-open");
        rows.forEach((r) => set(r, r === row && open));
      })
    );
  });
</script>
