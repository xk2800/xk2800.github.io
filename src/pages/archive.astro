---
import Credit from "../components/Credit.astro";
import Layout from "../layouts/Layout.astro";
import "@/styles/global.css";
import Chip from "../components/Chip.astro";
import { ArrowLeft, Award, ChevronDown, ChevronUp } from "lucide-react";

const pageTabTitle = "Project Archive | Xavier Khew";

import { archive } from "../content/archive";

const cols =
  "grid-cols-[4.5rem_minmax(0,1fr)_1.5rem] md:grid-cols-[6rem_minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1.6fr)_1.5rem]";
---

<Layout title={pageTabTitle}>
  <div class="mx-auto max-w-5xl">
    <a
      href="/"
      class="rise group sweep-first inline-flex w-fit items-center gap-2 text-sm font-medium text-baseTextColor no-underline transition-transform duration-150 ease-out active:scale-[0.98]"
      style="--i:0"
      transition:animate="slide"
    >
      <span
        aria-hidden="true"
        class="relative inline-block transition-transform duration-150 ease-out group-hover:-translate-x-0.5"
      >
        <ArrowLeft className="!transform-none !transition-none" />
        <span class="sweep-arrow">
          <ArrowLeft className="!transform-none !transition-none" />
        </span>
      </span>
      <span class="sweep-text">Xavier Khew</span>
    </a>

    <h1
      style="--i:1"
      class="rise mt-8 text-xl font-semibold tracking-tight text-baseTextCTAColor lg:text-2xl"
    >
      Project archive
    </h1>
    <p
      style="--i:2"
      class="rise mt-3 max-w-xl text-sm leading-relaxed text-subTextColor"
    >
      Client work from my years of experience. Open a project for the outcome,
      awards and full stack.
    </p>

    <!-- Column labels (desktop) -->
    <div
      style="--i:3"
      class={`rise mt-12 hidden gap-6 border-b border-baseTextColor/15 pb-3 text-xs font-medium text-subTextColor md:grid ${cols}`}
    >
      <span>Year</span>
      <span>Project</span>
      <span>Made at</span>
      <span>Built with</span>
      <span class="sr-only">Toggle</span>
    </div>

    <ul class="mt-8 border-t border-baseTextColor/15 md:mt-0 md:border-t-0">
      {archive.map((item, i) => (
        <li
          class="rise border-b border-baseTextColor/10"
          style={`--i:${3 + Math.min(i, 6) * 0.6}`}
        >
          <div data-acc data-open={i === 0 ? "" : undefined}>
            <button
              type="button"
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`panel-${i}`}
              class={`group grid w-full cursor-pointer items-baseline gap-4 py-5 text-left transition-colors duration-150 hover:bg-baseTextColor/[0.03] active:bg-baseTextColor/[0.06] md:gap-6 ${cols}`}
            >
              <span class="text-xs tabular-nums text-subTextColor">
                {item.year}
              </span>
              <span class="min-w-0">
                <span class="text-sm font-medium text-baseTextCTAColor transition-colors duration-150 group-hover:text-primaryCTAColor lg:text-base">
                  {item.project}
                </span>
                {item.awards.length > 0 && (
                  <span class="ml-2 inline-flex items-center gap-1 text-[0.8rem] font-medium text-primaryCTAColor">
                    <Award className="h-4 w-4" />{" "}
                    {item.awards.length === 1
                      ? "Award"
                      : `${item.awards.length} awards`}
                  </span>
                )}
              </span>
              <span class="hidden text-xs text-subTextColor md:block">
                {item.madeAt}
              </span>
              <span class="hidden text-xs leading-relaxed text-subTextColor md:block">
                {item.builtWith.join(" · ")}
              </span>
              <span
                aria-hidden="true"
                class="chevron grid self-center text-subTextColor transition-colors duration-200 group-hover:text-baseTextColor"
              >
                <ChevronDown className="down col-start-1 row-start-1 h-4 w-4" />
                <ChevronUp className="up col-start-1 row-start-1 h-4 w-4" />
                <ChevronUp className="up-red col-start-1 row-start-1 h-4 w-4" />
              </span>
            </button>

            <div id={`panel-${i}`} class="acc-panel" inert={i !== 0}>
              <div class="acc-inner">
                <div class="grid grid-cols-1 gap-6 pb-8 md:grid-cols-[6rem_minmax(0,1fr)]">
                  <span class="hidden md:block" aria-hidden="true" />
                  <div class="min-w-0">
                    <p class="max-w-2xl text-sm leading-relaxed text-subTextColor">
                      {item.description}
                    </p>
                    {item.awards.length > 0 && (
                      <ul class="mt-5 space-y-2">
                        {item.awards.map((a) => (
                          <li class="flex items-center gap-2.5 text-xs font-medium text-baseTextColor">
                            <span
                              class="flex shrink-0 text-primaryCTAColor"
                              aria-hidden="true"
                            >
                              <Award className="h-4 w-4" />
                            </span>
                            {a}
                          </li>
                        ))}
                      </ul>
                    )}
                    <p class="mt-5 text-xs text-subTextColor md:hidden">
                      Made at {item.madeAt}
                    </p>
                    <ul
                      class="mt-4 flex flex-wrap gap-2"
                      aria-label="Built with"
                    >
                      {item.builtWith.map((s, n) => (
                        <li class="chip-in" style={`--i:${Math.min(n, 6)}`}>
                          <Chip>{s}</Chip>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <footer class="mt-24 border-t border-baseTextColor/10 pt-8 text-xs text-subTextColor">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <Credit />
        <div class="flex items-center gap-5">
          <a class="footer-link" href="https://github.com/xk2800">
            Github
          </a>
          <a
            class="footer-link"
            href="https://www.linkedin.com/in/xavier-khew/"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style is:global>
  /* Crossfade between down/up chevrons: same spot, no pivot */
  .chevron svg {
    transition:
      opacity 200ms var(--ease-out-strong),
      transform 200ms var(--ease-out-strong),
      filter 200ms var(--ease-out-strong),
      clip-path 250ms var(--ease-out-strong);
  }
  .chevron .up,
  .chevron .up-red,
  [data-open] .chevron .down {
    opacity: 0;
    transform: scale(0.8);
    filter: blur(2px);
  }
  [data-open] .chevron .up,
  [data-open] .chevron .up-red {
    opacity: 1;
    transform: none;
    filter: none;
  }
  /* Red copy of the up chevron, swept in left to right over the grey one */
  .chevron .up-red {
    color: #9b111a;
    clip-path: inset(0 100% 0 0);
  }
  [data-open] .chevron .up-red {
    clip-path: inset(0);
  }
</style>

<script>
  // One row open at a time; re-bound on every navigation (router swaps the DOM).
  document.addEventListener("astro:page-load", () => {
    const rows = document.querySelectorAll<HTMLElement>("[data-acc]");
    const set = (row: HTMLElement, open: boolean) => {
      row.toggleAttribute("data-open", open);
      row.querySelector("button")!.setAttribute("aria-expanded", String(open));
      row.querySelector<HTMLElement>(".acc-panel")!.inert = !open;
    };
    rows.forEach((row) =>
      row.querySelector("button")!.addEventListener("click", () => {
        const open = !row.hasAttribute("data-open");
        rows.forEach((r) => set(r, r === row && open));
      }),
    );
  });
</script>
